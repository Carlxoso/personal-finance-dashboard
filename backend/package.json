  "devDependencies": { "@types/cookie-parser": "^1.4.7", "@types/cors": "^2.8.17", "@types/express": "^5.0.0", "@types/jsonwebtoken": "^9.0.7", "@types/node": "^22.0.0", "@types/supertest": "^6.0.2", "prisma": "^6.0.0", "tsx": "^4.19.0", "supertest": "^7.0.0", "typescript": "^5.6.0", "vitest": "^2.1.0" } }
